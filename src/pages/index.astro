---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'The Night Prince',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Read the latest', href: '/blog' },
      { text: 'About', href: '/about' },
    ]}
  >
    <Fragment slot="title">The Night Prince</Fragment>

    <Fragment slot="subtitle">Poems, stories, and other nocturnal musings.</Fragment>
  </Hero>

  <!-- Latest posts ****************** -->

  <BlogLatestPosts title="Latest posts" />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[{ variant: 'primary', text: 'See all posts', href: '/blog' }]}
  >
    <Fragment slot="title">More where that came from</Fragment>
    <Fragment slot="subtitle">Every post, oldest to newest, tags and all.</Fragment>
  </CallToAction>
</Layout>
