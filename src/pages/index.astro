---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="The Night Prince">
  {
    posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>
              {post.data.image && <Image src={post.data.image} alt="" width={640} height={360} />}
              <h2>{post.data.title}</h2>
              <p class="date">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              {post.data.excerpt && <p class="excerpt">{post.data.excerpt}</p>}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
