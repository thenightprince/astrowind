---
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <Hero tagline="About">
    <Fragment slot="title">Who's writing this</Fragment>
  </Hero>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16">
    <p class="text-lg leading-relaxed mb-4">
      <em
        >This is placeholder copy &mdash; replace it with a few real sentences about
        yourself: who you are, what you write about, and why.</em
      >
    </p>
    <p class="text-lg leading-relaxed">
      The Night Prince is a place for poems, short fiction, and whatever else
      doesn't fit anywhere else &mdash; written mostly at night, mostly for the
      people it's about.
    </p>
  </section>
</Layout>
