---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="Get in touch" />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 text-lg leading-relaxed">
    <p>
      <em
        >Placeholder &mdash; the template's demo contact form (with a "Contact sales" /
        "phone support" section) has been removed since it doesn't apply here, and a
        working submit button needs a form-handling service wired up separately. Swap
        this paragraph for a real way to reach you: an email address, or links to
        wherever you actually want messages to land.</em
      >
    </p>
  </section>
</Layout>
