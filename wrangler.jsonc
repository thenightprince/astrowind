{
	// Pure static site: Astro pre-renders every page at build time, so this
	// Worker only needs to serve the pre-built ./dist folder as static assets.
	//
	// This file exists specifically so `wrangler deploy` doesn't fall back to
	// its automatic-configuration flow (which, for Astro projects, installs
	// the @astrojs/cloudflare adapter and switches to on-demand/server
	// rendering -- unnecessary here, and the source of a broken-images bug
	// on the previous AstroWind-based version of this site). Declaring a
	// plain assets-only Worker up front avoids all of that.
	"name": "astrowind",
	"compatibility_date": "2026-09-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
